{
    "cli": {
        "version": ">= 5.2.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "API_URL": "http://192.168.1.100:5000/api"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "API_URL": "https://your-staging-api.com/api"
            }
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "env": {
                "API_URL": "https://your-production-api.com/api"
            }
        }
    },
    "submit": {
        "production": {}
    }
}